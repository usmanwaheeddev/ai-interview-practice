# Copy to .env.production and replace every CHANGE_ME value.
POSTGRES_PASSWORD=CHANGE_ME_USE_A_LONG_RANDOM_VALUE
JWT_SECRET=CHANGE_ME_USE_AT_LEAST_32_RANDOM_BYTES
CORS_ORIGINS=["https://interview.example.com"]
TRUST_PROXY_HEADERS=true

S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME_USE_A_LONG_RANDOM_VALUE
S3_BUCKET=ai-interview-practice
S3_REGION=us-east-1
S3_PUBLIC_ENDPOINT_URL=https://storage.example.com
STORAGE_PROVIDER=s3

# DeepSeek is primary and local Ollama is its only fallback.
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=CHANGE_ME
DEEPSEEK_MODEL=deepseek-flash
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2:3b

STT_PROVIDER=faster_whisper
STT_ENGINE=faster_whisper
WHISPER_MODEL_SIZE=base
WHISPER_CPU_THREADS=2
WHISPER_BEAM_SIZE=1
WHISPER_SEGMENT_TIMEOUT_S=90

TTS_PROVIDER=piper
PIPER_VOICE=en_US-lessac-medium
PIPER_VOICE_HI=hi_IN-pratham-medium
PIPER_VOICES_DIR=/home/app/.local/share/piper-voices
