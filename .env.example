# Copy to .env and fill in for local dev. Never commit the real .env.
# Credentials below are public development defaults, not production secrets.
# Use unique credentials and a strong JWT secret before any deployment.

ENV=development
DEBUG=true

DATABASE_URL=postgresql+asyncpg://hiring:hiring@localhost:5432/hiring
REDIS_URL=redis://localhost:6379/0

S3_ENDPOINT_URL=http://localhost:9000
# Used only to sign presigned URLs the browser calls directly — must be an
# address the browser can reach, unlike S3_ENDPOINT_URL when the backend
# runs in docker-compose (there it's the internal hostname `minio`).
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=hiring-interview
S3_REGION=us-east-1

JWT_SECRET=dev-only-change-me-this-must-be-at-least-32-bytes-long
CORS_ORIGINS=["http://localhost:5173"]

# Provider selection.
# "fake" is always safe (tests, CI). Choose which real provider is tried first;
# the other one remains the automatic fallback.
# Docker Desktop cannot expose Apple Metal to Ollama inside its Linux VM.
# Use the host-native provider or an optional cloud fallback when needed.
LLM_PROVIDER=ollama
STT_PROVIDER=faster_whisper
# Selects the concrete local Whisper engine. Existing behavior is preserved
# by the default. Set whisper_cpp only when running the API directly on macOS;
# Docker Desktop's Linux VM cannot access Apple Metal.
STT_ENGINE=faster_whisper
TTS_PROVIDER=piper
STORAGE_PROVIDER=s3
EXECUTION_PROVIDER=piston

OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:1b

# Coding-challenge sandbox (Phase 1). Run `make piston-setup` once after
# `make up` so the `piston` container has Python/Java/C# installed.
PISTON_BASE_URL=http://piston:2000
# Optional engine-neutral override. Leave blank to retain the existing
# faster-whisper WHISPER_MODEL_SIZE setting.
STT_MODEL_SIZE=
WHISPER_MODEL_SIZE=small
WHISPER_CPU_THREADS=4
WHISPER_BEAM_SIZE=1
WHISPER_SEGMENT_TIMEOUT_S=60
# Required only for STT_ENGINE=whisper_cpp. Use absolute host paths.
WHISPER_CPP_BINARY_PATH=/Users/you/src/whisper.cpp/build/bin/whisper-cli
WHISPER_CPP_MODEL_PATH=/Users/you/src/whisper.cpp/models/ggml-small.en-q5_0.bin
WHISPER_CPP_THREADS=4
PIPER_VOICE=en_US-lessac-medium
# Hindi voice for Piper. Urdu has no Piper voice at all — spoken Urdu falls
# back to the espeak-ng binary installed in the backend image.
PIPER_VOICE_HI=hi_IN-pratham-medium
PIPER_VOICES_DIR=/opt/piper-voices

# Optional Groq fallback. Obtain a key from the provider; never commit it.
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
