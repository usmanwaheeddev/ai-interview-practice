# Copy to .env for local development. Never commit the real .env.
# These database/storage credentials are development-only defaults.
ENV=development
DEBUG=true

DATABASE_URL=postgresql+asyncpg://hiring:hiring@localhost:5432/hiring
REDIS_URL=redis://localhost:6379/0

S3_ENDPOINT_URL=http://localhost:9000
# Browser-visible URL used when signing direct uploads. Compose keeps this on
# localhost even though backend containers use the internal rustfs hostname.
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=rustfsadmin
S3_SECRET_KEY=rustfsadmin
S3_BUCKET=ai-interview-practice
S3_REGION=us-east-1

JWT_SECRET=dev-only-change-me-this-must-be-at-least-32-bytes-long
CORS_ORIGINS=["http://localhost:5173"]

LLM_PROVIDER=deepseek
# DeepSeek is the only hosted LLM. Local Ollama is its automatic fallback.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
# Container-visible Ollama endpoint. Use host.docker.internal here to run
# Ollama natively on macOS while keeping API/worker in Docker.
OLLAMA_DOCKER_URL=http://ollama:11434

STT_PROVIDER=faster_whisper
STT_ENGINE=faster_whisper
TTS_PROVIDER=piper
STORAGE_PROVIDER=s3

# Optional engine-neutral model override. Leave blank to use WHISPER_MODEL_SIZE.
STT_MODEL_SIZE=
WHISPER_MODEL_SIZE=base
WHISPER_CPU_THREADS=4
WHISPER_BEAM_SIZE=1
WHISPER_SEGMENT_TIMEOUT_S=60
# Required only for STT_ENGINE=whisper_cpp; use absolute host paths.
WHISPER_CPP_BINARY_PATH=/Users/you/src/whisper.cpp/build/bin/whisper-cli
WHISPER_CPP_MODEL_PATH=/Users/you/src/whisper.cpp/models/ggml-small.en-q5_0.bin
WHISPER_CPP_THREADS=4
PIPER_VOICE=en_US-lessac-medium
PIPER_VOICE_HI=hi_IN-pratham-medium
# PIPER_VOICES_DIR is optional. Local runs use the current user's OS cache;
# Compose overrides it with a persistent Docker volume.
